---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rgg
  labels:
    app.kubernetes.io/name: rgg
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: rgg
  template:
    metadata:
      labels:
        app.kubernetes.io/name: rgg
    spec:
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
      containers:
        - name: rgg
          image: {{ RGG_DOCKER_IMAGE }}
          ports:
            - containerPort: 8000
          env:
            - name: DJANGO_SETTINGS_MODULE
              value: gamma.settings.tutor.production
            - name: MONGO_URL
              value: mongodb://mongodb:27017/
            - name: MONGO_DATABASE
              value: gamma_data
          volumeMounts:
            - mountPath: /rgg/gamma/gamma/settings/tutor/production.py
              name: settings
              subPath: production.py
          securityContext:
            allowPrivilegeEscalation: false
      volumes:
        - name: settings
          configMap:
            name: rgg-settings
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rgg-worker
  labels:
    app.kubernetes.io/name: rgg-worker
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: rgg-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: rgg-worker
    spec:
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
      containers:
        - name: rgg-worker
          image: {{ RGG_DOCKER_IMAGE }}
          args: ["celery", "--app=gamma", "worker", "--loglevel=info"]
          env:
            - name: DJANGO_SETTINGS_MODULE
              value: gamma.settings.tutor.production
            - name: MONGO_URL
              value: mongodb://mongodb:27017/
            - name: MONGO_DATABASE
              value: gamma_data
          volumeMounts:
            - mountPath: /rgg/gamma/gamma/settings/tutor/production.py
              name: settings
              subPath: production.py
          securityContext:
            allowPrivilegeEscalation: false
      volumes:
        - name: settings
          configMap:
            name: rgg-settings
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rgg-beat
  labels:
    app.kubernetes.io/name: rgg-beat
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: rgg-beat
  template:
    metadata:
      labels:
        app.kubernetes.io/name: rgg-beat
    spec:
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
      containers:
        - name: rgg-beat
          image: {{ RGG_DOCKER_IMAGE }}
          args: ["celery", "beat", "--app=gamma", "--loglevel=info"]
          env:
            - name: DJANGO_SETTINGS_MODULE
              value: gamma.settings.tutor.production
            - name: MONGO_URL
              value: mongodb://mongodb:27017/
            - name: MONGO_DATABASE
              value: gamma_data
          volumeMounts:
            - mountPath: /rgg/gamma/gamma/settings/tutor/production.py
              name: settings
              subPath: production.py
          securityContext:
            allowPrivilegeEscalation: false
      volumes:
        - name: settings
          configMap:
            name: rgg-settings
