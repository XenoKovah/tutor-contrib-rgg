# RG Gamification
rgg:
  image: {{ RGG_DOCKER_IMAGE }}
  environment:
    DJANGO_SETTINGS_MODULE: gamma.settings.tutor.production
    MONGO_URL: mongodb://mongodb:27017/
    MONGO_DATABASE: gamma_data
  volumes:
    - ../plugins/rgg/apps/settings/tutor:/rgg/gamma/gamma/settings/tutor:ro
    - ../../data/rgg:/rgg/gamma/gamma/media/media:rw
  restart: unless-stopped
  depends_on:
    - lms
    - mongodb
    - redis
    {% if RUN_MYSQL %}- mysql{% endif %}

# RG Gamification Worker
rgg-worker:
  image: {{ RGG_DOCKER_IMAGE }}
  command: celery -A gamma worker -l info
  environment:
    DJANGO_SETTINGS_MODULE: gamma.settings.tutor.production
    MONGO_URL: mongodb://mongodb:27017/
    MONGO_DATABASE: gamma_data
  volumes:
    - ../plugins/rgg/apps/settings/tutor:/rgg/gamma/gamma/settings/tutor:ro
  restart: unless-stopped
  depends_on: 
    - lms
    - mongodb
    - redis
    {% if RUN_MYSQL %}- mysql{% endif %}
