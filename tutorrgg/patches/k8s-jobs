---
apiVersion: batch/v1
kind: Job
metadata:
  name: rgg-job
  labels:
    app.kubernetes.io/component: job
spec:
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: rgg
          image: {{ RGG_DOCKER_IMAGE }}
          env:
            - name: DJANGO_SETTINGS_MODULE
              value: gamma.settings.tutor.production
          volumeMounts:
            - mountPath: /rgg/gamma/gamma/settings/tutor/production.py
              name: settings
              subPath: production.py
      volumes:
        - name: settings
          configMap:
            name: rgg-settings
