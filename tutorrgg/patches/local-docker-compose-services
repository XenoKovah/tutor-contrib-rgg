# RG Gamification
rgg:
  image: docker.io/rgg:latest
  environment:
    - DB_ENGINE=django.db.backends.mysql
    - DB_NAME=rgg
    - DB_USER=rgg
    - DB_PASSWORD={{ RGG_MYSQL_PASSWORD }}
    - DB_HOST=mysql
    - DB_PORT=3306
    - MONGO_URL=mongodb://mongodb:27017/
    - MONGO_DATABASE=gamma_data
    - EDX_LMS_BASE_URL=http://lms
    - EDX_API_KEY={{ EDX_API_KEY }}
    - CELERY_BROKER_URL=redis://redis:6379/2
  volumes:
    - ../../data/rgg:/rgg/gamma/gamma/media/media:rw
  restart: unless-stopped
  depends_on:
    - lms
    - mongodb
    - redis
    {% if RUN_MYSQL %}- mysql{% endif %}

# RG Gamification Worker
rgg-worker:
  image: docker.io/rgg:latest
  command: celery -A gamma worker -l info
  environment:
    - DB_ENGINE=django.db.backends.mysql
    - DB_NAME=rgg
    - DB_USER=rgg
    - DB_PASSWORD={{ RGG_MYSQL_PASSWORD }}
    - DB_HOST=mysql
    - DB_PORT=3306
    - MONGO_URL=mongodb://mongodb:27017/
    - MONGO_DATABASE=gamma_data
    - EDX_LMS_BASE_URL=http://lms
    - EDX_API_KEY={{ EDX_API_KEY }}
    - CELERY_BROKER_URL=redis://redis:6379/2
  restart: unless-stopped
  depends_on: 
    - lms
    - mongodb
    - redis
    {% if RUN_MYSQL %}- mysql{% endif %}
