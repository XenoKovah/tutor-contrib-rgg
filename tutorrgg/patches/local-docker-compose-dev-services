# RG Gamification
rgg:
  image: docker.io/rgg-dev:latest
  environment:
    - DB_ENGINE=django.db.backends.mysql
    - DB_NAME=rgg
    - DB_USER=rgg
    - DB_PASSWORD={{ RGG_MYSQL_PASSWORD }}
    - DB_HOST=mysql
    - DB_PORT=3306
    - MONGO_URL=mongodb://mongodb:27017/
    - MONGO_DATABASE=gamma_data
    - EDX_LMS_BASE_URL=http://{{ LMS_HOST }}:8000
    - EDX_API_KEY={{ EDX_API_KEY }}
    - DJANGO_SETTINGS_MODULE=gamma.settings.tutor.development
  volumes:
    - ../../data/rgg:/rgg/gamma/gamma/media/media:rw
    {%- for mount in iter_mounts(MOUNTS, "gamma") %}
      - {{ mount }}
    {%- endfor %}
  command: ./manage.py runserver 0.0.0.0:9700
  stdin_open: true
  tty: true
  ports:
    - "9700:9700"
  networks:
    default:
      aliases:
        - "{{ RGG_HOST }}"

# RG Gamification Worker
rgg-worker:
  image: docker.io/rgg-dev:latest
  command: celery -A gamma worker -l info
  environment:
    - DJANGO_SETTINGS_MODULE=gamma.settings.devstack
    - DB_ENGINE=django.db.backends.mysql
    - DB_NAME=rgg
    - DB_USER=rgg
    - DB_PASSWORD={{ RGG_MYSQL_PASSWORD }}
    - DB_HOST=mysql
    - DB_PORT=3306
    - MONGO_URL=mongodb://mongodb:27017/
    - MONGO_DATABASE=gamma_data
    - EDX_LMS_BASE_URL=http://{{ LMS_HOST }}:8000
    - EDX_API_KEY={{ EDX_API_KEY }}
    - CELERY_BROKER_URL=redis://redis:6379/1
  volumes:
    - ../../data/rgg:/rgg/gamma/gamma/media/media:rw
    {%- for mount in iter_mounts(MOUNTS, "gamma") %}
      - {{ mount }}
    {%- endfor %}
  restart: unless-stopped
  depends_on: 
    - lms
    - mongodb
    - redis
    {% if RUN_MYSQL %}- mysql{% endif %}
