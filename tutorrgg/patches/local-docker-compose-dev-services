# RG Gamification
rgg:
  image: {{ RGG_DOCKER_IMAGE_DEV }}
  environment:
    DJANGO_SETTINGS_MODULE: gamma.settings.tutor.development
  volumes:
    - ../../data/rgg:/rgg/gamma/gamma/media/media:rw
    {%- for mount in iter_mounts(MOUNTS, "rgg") %}
    - {{ mount }}
    {%- endfor %}
  command: ./manage.py runserver 0.0.0.0:8000
  stdin_open: true
  tty: true
  ports:
    - "9700:8000"
  networks:
    default:
      aliases:
        - "{{ RGG_HOST }}"

# RG Gamification Worker
rgg-worker:
  image: {{ RGG_DOCKER_IMAGE_DEV }}
  command: celery -A gamma worker -l info
  environment:
    DJANGO_SETTINGS_MODULE: gamma.settings.tutor.development
  volumes:
    - ../../data/rgg:/rgg/gamma/gamma/media/media:rw
    {%- for mount in iter_mounts(MOUNTS, "rgg-worker") %}
    - {{ mount }}
    {%- endfor %}
  restart: unless-stopped
  depends_on:
    - lms
    - redis
    {% if RUN_MYSQL %}- mysql{% endif %}

# RG Gamification Beat
rgg-beat:
  image: {{ RGG_DOCKER_IMAGE_DEV }}
  command: celery beat -A gamma --loglevel=INFO
  environment:
    DJANGO_SETTINGS_MODULE: gamma.settings.tutor.development
  volumes:
    - ../../data/rgg:/rgg/gamma/gamma/media/media:rw
    {%- for mount in iter_mounts(MOUNTS, "rgg-beat") %}
    - {{ mount }}
    {%- endfor %}
  restart: unless-stopped
  depends_on:
    - lms
    - redis
    {% if RUN_MYSQL %}- mysql{% endif %}
