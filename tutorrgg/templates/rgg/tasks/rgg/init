python manage.py migrate

python manage.py \
      shell -c "from django.contrib.auth.models import User; \
      User.objects.filter(username='{{ RGG_DJANGO_ADMIN_USER }}').exists() or \
      User.objects.create_superuser('{{ RGG_DJANGO_ADMIN_USER }}', '{{ RGG_DJANGO_ADMIN_EMAIL }}', '{{ RGG_DJANGO_ADMIN_PASS }}')"

python manage.py \
      shell -c "from core.models import AppClient; \
      AppClient.objects.get_or_create(name='main', key='{{ RGG_DEFAULT_APP_KEY }}', secret='{{ RGG_DEFAULT_APP_SECRET }}')"

# Changing SITE domain to match the one in the environment
# We assume that we have only one site in the database
python manage.py \
        shell -c "from django.contrib.sites.models import Site; \
        Site.objects.update(domain='{{ RGG_HOST }}', name='{{ RGG_HOST }}')"
